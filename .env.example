# ==============================================================================
# CivicPulse Nexus — Production Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# ── 1. DOMAIN & HOST CONFIGURATION ───────────────────────────────────────────
PUBLIC_DOMAIN=civicpulse.example.com
FRONTEND_URL=https://civicpulse.example.com
API_GATEWAY_URL=https://api.civicpulse.example.com
KEYCLOAK_URL=https://auth.civicpulse.example.com

# ── 2. POSTGRESQL DATABASE CONFIGURATION ──────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse_db
POSTGRES_USER=civicpulse_admin
POSTGRES_PASSWORD=YOUR_PRODUCTION_DB_PASSWORD_HERE

# ── 3. APACHE KAFKA MESSAGE BROKER ───────────────────────────────────────────
KAFKA_BROKER_HOST=kafka
KAFKA_BROKER_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── 4. KEYCLOAK IDENTITY & ACCESS MANAGEMENT ─────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=YOUR_PRODUCTION_KEYCLOAK_ADMIN_PASSWORD_HERE
KEYCLOAK_REALM=civicpulse
KEYCLOAK_ISSUER_URI=https://auth.civicpulse.example.com/realms/civicpulse
KEYCLOAK_CLIENT_ID=citizen-frontend
KEYCLOAK_CLIENT_SECRET=YOUR_KEYCLOAK_CLIENT_SECRET_IF_CONFIDENTIAL

# ── 5. AI GOVERNANCE INTELLIGENCE (GEMINI API) ────────────────────────────────
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY_HERE

# ── 6. EUREKA SERVICE DISCOVERY ───────────────────────────────────────────────
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

# ── 7. SPRING BOOT MICROSERVICES PROFILES ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
